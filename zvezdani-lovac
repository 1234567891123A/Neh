<!DOCTYPE html>
<html lang="sr">
<head>
<meta charset="UTF-8">
<title>Zvezdani Lovac</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #000;
    height: 100%;
    font-family: 'Courier New', monospace;
  }
  canvas {
    display: block;
    cursor: crosshair;
  }
  #hud {
    position: fixed;
    top: 16px;
    left: 16px;
    color: #0ff;
    font-size: 18px;
    text-shadow: 0 0 8px #0ff;
    user-select: none;
    pointer-events: none;
    line-height: 1.6;
  }
  #hud .label { color: #6cf; font-size: 12px; }
  #msg {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    font-size: 18px;
    text-align: center;
    user-select: none;
    pointer-events: none;
    text-shadow: 0 0 10px #0ff;
    line-height: 1.8;
  }
  #msg h1 {
    font-size: 42px;
    margin: 0 0 10px 0;
    color: #0ff;
    text-shadow: 0 0 20px #0ff;
    letter-spacing: 4px;
  }
  #bar {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  #barFill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #0ff, #0f8);
    transition: width 0.2s;
  }
</style>
</head>
<body>
<div id="hud">
  <div><span class="label">REZULTAT</span> <span id="score">0</span></div>
  <div><span class="label">NIVO</span> <span id="level">1</span></div>
  <div><span class="label">ŽIVOTI</span> <span id="lives">3</span></div>
</div>
<div id="bar"><div id="barFill"></div></div>
<div id="msg">
  <h1>ZVEZDANI LOVAC</h1>
  Miš = pomeranje &nbsp;|&nbsp; Klik ili SPACE = pucaj<br>
  Uništi asteroide i neprijatelje pre nego što te udare<br><br>
  <b>Klikni da počneš</b>
</div>
<canvas id="canvas"></canvas>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const levelEl = document.getElementById('level');
const livesEl = document.getElementById('lives');
const msg = document.getElementById('msg');
const barFill = document.getElementById('barFill');

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// ---------- ZVUK (Web Audio, bez fajlova) ----------
let audioCtx;
function ensureAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}
function beep(freq, duration, type = 'square', volume = 0.08) {
  if (!audioCtx) return;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.value = volume;
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
  osc.stop(audioCtx.currentTime + duration);
}
function sfxShoot() { beep(880, 0.08, 'square', 0.05); }
function sfxHit() { beep(220, 0.15, 'sawtooth', 0.09); }
function sfxExplode() { beep(90, 0.3, 'sawtooth', 0.12); }
function sfxLevelUp() {
  beep(440, 0.12, 'triangle', 0.1);
  setTimeout(() => beep(660, 0.12, 'triangle', 0.1), 100);
  setTimeout(() => beep(880, 0.18, 'triangle', 0.1), 200);
}

// ---------- STANJE IGRE ----------
let ship, bullets, enemies, particles, stars;
let score, level, lives, gameRunning, spawnTimer, shootCooldown, shake;
const mouse = { x: 0, y: 0 };

function reset() {
  ship = { x: canvas.width / 2, y: canvas.height / 2, radius: 14, angle: 0 };
  bullets = [];
  enemies = [];
  particles = [];
  stars = [];
  for (let i = 0; i < 120; i++) {
    stars.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.5 + 0.3,
      speed: Math.random() * 0.5 + 0.1
    });
  }
  score = 0;
  level = 1;
  lives = 3;
  spawnTimer = 0;
  shootCooldown = 0;
  shake = 0;
  gameRunning = false;
  updateHud();
  barFill.style.width = '0%';
}

function updateHud() {
  scoreEl.textContent = score;
  levelEl.textContent = level;
  livesEl.textContent = '❤'.repeat(Math.max(lives, 0)) || '—';
}

function startGame() {
  ensureAudio();
  if (!gameRunning) {
    gameRunning = true;
    msg.style.display = 'none';
  }
}

canvas.addEventListener('mousemove', (e) => {
  mouse.x = e.clientX;
  mouse.y = e.clientY;
});
canvas.addEventListener('mousedown', () => {
  if (!gameRunning) { startGame(); return; }
  shoot();
});
window.addEventListener('keydown', (e) => {
  if (e.code === 'Space') {
    e.preventDefault();
    if (!gameRunning) startGame();
    else shoot();
  }
});

function shoot() {
  if (shootCooldown > 0) return;
  shootCooldown = 10;
  const dx = mouse.x - ship.x;
  const dy = mouse.y - ship.y;
  const dist = Math.hypot(dx, dy) || 1;
  bullets.push({
    x: ship.x,
    y: ship.y,
    vx: (dx / dist) * 11,
    vy: (dy / dist) * 11,
    life: 60
  });
  sfxShoot();
}

function spawnEnemy() {
  const edge = Math.floor(Math.random() * 4);
  let x, y;
  if (edge === 0) { x = -30; y = Math.random() * canvas.height; }
  else if (edge === 1) { x = canvas.width + 30; y = Math.random() * canvas.height; }
  else if (edge === 2) { x = Math.random() * canvas.width; y = -30; }
  else { x = Math.random() * canvas.width; y = canvas.height + 30; }

  const size = 14 + Math.random() * 18;
  const speed = 0.8 + Math.random() * 0.6 + level * 0.15;
  enemies.push({
    x, y, size,
    speed,
    hp: Math.ceil(size / 12),
    hue: Math.random() * 360,
    rot: Math.random() * Math.PI * 2,
    rotSpeed: (Math.random() - 0.5) * 0.05,
    wobble: Math.random() * Math.PI * 2
  });
}

function spawnParticles(x, y, hue, count = 14) {
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2;
    const s = 1 + Math.random() * 5;
    particles.push({
      x, y,
      vx: Math.cos(a) * s,
      vy: Math.sin(a) * s,
      life: 1,
      hue
    });
  }
}

function gameOver() {
  gameRunning = false;
  msg.innerHTML = `<h1>KRAJ IGRE</h1>Rezultat: ${score} &nbsp;|&nbsp; Dostignut nivo: ${level}<br><br><b>Klikni da pokušaš ponovo</b>`;
  msg.style.display = 'block';
  setTimeout(() => {
    canvas.addEventListener('mousedown', restartOnce, { once: true });
  }, 300);
}
function restartOnce() { reset(); }

function update() {
  for (const s of stars) {
    s.y += s.speed;
    if (s.y > canvas.height) { s.y = 0; s.x = Math.random() * canvas.width; }
  }

  if (!gameRunning) return;

  if (shootCooldown > 0) shootCooldown--;
  if (shake > 0) shake *= 0.9;

  // brod prati miša glatko
  ship.angle = Math.atan2(mouse.y - ship.y, mouse.x - ship.x);
  ship.x += (mouse.x - ship.x) * 0.12;
  ship.y += (mouse.y - ship.y) * 0.12;

  // spawn neprijatelja, brže sa nivoom
  spawnTimer++;
  const spawnRate = Math.max(20, 70 - level * 5);
  if (spawnTimer > spawnRate) {
    spawnEnemy();
    spawnTimer = 0;
  }

  // level up na osnovu skora
  const nextLevelScore = level * 150;
  barFill.style.width = Math.min(100, (score % 150) / 150 * 100) + '%';
  if (score >= nextLevelScore) {
    level++;
    sfxLevelUp();
    updateHud();
  }

  // meci
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.x += b.vx;
    b.y += b.vy;
    b.life--;
    if (b.life <= 0 || b.x < 0 || b.x > canvas.width || b.y < 0 || b.y > canvas.height) {
      bullets.splice(i, 1);
    }
  }

  // neprijatelji
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    e.rot += e.rotSpeed;
    e.wobble += 0.05;
    const dx = ship.x - e.x;
    const dy = ship.y - e.y;
    const dist = Math.hypot(dx, dy) || 1;
    e.x += (dx / dist) * e.speed + Math.sin(e.wobble) * 0.4;
    e.y += (dy / dist) * e.speed + Math.cos(e.wobble) * 0.4;

    // sudar sa brodom
    if (dist < e.size + ship.radius) {
      enemies.splice(i, 1);
      lives--;
      shake = 15;
      sfxHit();
      spawnParticles(ship.x, ship.y, 0, 20);
      updateHud();
      if (lives <= 0) gameOver();
      continue;
    }

    // sudar sa mecima
    for (let j = bullets.length - 1; j >= 0; j--) {
      const b = bullets[j];
      if (Math.hypot(b.x - e.x, b.y - e.y) < e.size) {
        bullets.splice(j, 1);
        e.hp--;
        spawnParticles(b.x, b.y, e.hue, 6);
        if (e.hp <= 0) {
          score += Math.round(e.size);
          spawnParticles(e.x, e.y, e.hue, 22);
          sfxExplode();
          shake = Math.max(shake, 6);
          enemies.splice(i, 1);
          updateHud();
        } else {
          sfxHit();
        }
        break;
      }
    }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vx *= 0.96;
    p.vy *= 0.96;
    p.life -= 0.025;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function draw() {
  ctx.save();
  if (shake > 0.5) {
    ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
  }

  ctx.fillStyle = '#000';
  ctx.fillRect(-20, -20, canvas.width + 40, canvas.height + 40);

  // zvezde
  ctx.fillStyle = '#fff';
  for (const s of stars) {
    ctx.globalAlpha = 0.5 + s.speed;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;

  // čestice
  for (const p of particles) {
    ctx.globalAlpha = Math.max(p.life, 0);
    ctx.beginPath();
    ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = `hsl(${p.hue}, 100%, 60%)`;
    ctx.fill();
  }
  ctx.globalAlpha = 1;

  // meci
  for (const b of bullets) {
    ctx.beginPath();
    ctx.arc(b.x, b.y, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#0ff';
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#0ff';
    ctx.fill();
    ctx.shadowBlur = 0;
  }

  // neprijatelji (nepravilni asteroidi)
  for (const e of enemies) {
    ctx.save();
    ctx.translate(e.x, e.y);
    ctx.rotate(e.rot);
    ctx.beginPath();
    const spikes = 7;
    for (let i = 0; i < spikes; i++) {
      const a = (i / spikes) * Math.PI * 2;
      const r = e.size * (0.8 + 0.2 * Math.sin(i * 3 + e.wobble));
      const px = Math.cos(a) * r;
      const py = Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.fillStyle = `hsl(${e.hue}, 70%, 45%)`;
    ctx.shadowBlur = 12;
    ctx.shadowColor = `hsl(${e.hue}, 70%, 50%)`;
    ctx.fill();
    ctx.restore();
  }

  // brod
  if (gameRunning || lives > 0) {
    ctx.save();
    ctx.translate(ship.x, ship.y);
    ctx.rotate(ship.angle);
    ctx.beginPath();
    ctx.moveTo(18, 0);
    ctx.lineTo(-12, 10);
    ctx.lineTo(-6, 0);
    ctx.lineTo(-12, -10);
    ctx.closePath();
    ctx.fillStyle = '#fff';
    ctx.shadowBlur = 15;
    ctx.shadowColor = '#0ff';
    ctx.fill();
    ctx.restore();
  }

  ctx.restore();
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

reset();
loop();
</script>
</body>
</html>
